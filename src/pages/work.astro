---
import CountUp from '../components/CountUp.astro';
import Base from '../layouts/Base.astro';
import Slot from '../components/Slot.astro';
import { href } from '../lib/url';
import { projects, categories } from '../data/projects';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<Base
  title="Work | Julienna Batten"
  description="Selected projects: brand systems, web design, product visualization, motion, and the automation pipelines behind them."
>
  <header class="page-head shell">
    <h1 class="text-display">The work, sorted by discipline</h1>
    <p class="mt-4 max-w-[52ch] text-body text-muted">
      Everything from 2017 on, from client systems to posters for local shows. Filter by discipline to see how much of it overlaps.
    </p>
  </header>

  <section class="shell mt-10" aria-label="Project filters">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects by category" data-filter-bar>
      <button type="button" class="chip filter-chip" data-filter="all" aria-pressed="true">All</button>
      {categories.map((c) => (
        <button type="button" class="chip filter-chip" data-filter={c} aria-pressed="false">{c}</button>
      ))}
    </div>
    <p id="filter-count" class="mt-3 text-small text-muted" aria-live="polite">
      Showing all {projects.length} projects
    </p>
  </section>

  <section class="shell mt-6" aria-label="Featured projects">
    {featured.map((p) => (
      <article id={p.slug} class="featured-row" data-categories={p.categories.join(' ')}>
        <a class="row-media" href={href(`/work#${p.slug}`)} tabindex="-1" aria-hidden="true">
          <Slot ratio="16 / 10" brief={p.brief} radius="media" />
        </a>
        <div class="row-copy">
          <p class="meta text-muted">{p.client}, {p.years}</p>
          <h2 class="mt-2 text-h3">
            <a class="entry-link" href={href(`/work#${p.slug}`)}>{p.title}</a>
          </h2>
          <p class="mt-3 max-w-[46ch] text-body text-muted">{p.summary}</p>
          {p.outcome && (
            <p class="mt-4"><span class="chip"><CountUp text={p.outcome} /></span></p>
          )}
          <p class="mt-4 text-small text-dash-ink">Case study coming soon</p>
        </div>
      </article>
    ))}
  </section>

  <section class="shell work-grid mt-14 border-t border-line pt-10" aria-label="More projects">
    {rest.map((p) => (
      <article id={p.slug} class="grid-entry" data-categories={p.categories.join(' ')}>
        <a href={href(`/work#${p.slug}`)} tabindex="-1" aria-hidden="true">
          <Slot ratio="4 / 3" brief={p.brief} radius="card" />
        </a>
        <p class="meta mt-4 text-muted">{p.client}, {p.years}</p>
        <h2 class="mt-1 text-[1.0625rem] font-semibold tracking-[-0.01em]">
          <a class="entry-link" href={href(`/work#${p.slug}`)}>{p.title}</a>
        </h2>
        <p class="mt-2 text-small text-muted">{p.summary}</p>
        {p.outcome && (
          <p class="mt-3"><span class="chip"><CountUp text={p.outcome} /></span></p>
        )}
        <p class="mt-3 text-small text-dash-ink">Case study coming soon</p>
      </article>
    ))}
  </section>

  <section class="shell mt-20 mb-24 flex flex-wrap items-center justify-between gap-6 border-t border-line pt-10" aria-label="Contact prompt">
    <p class="text-h3">Case studies are on the way. Until then, I'm happy to walk you through any of these.</p>
    <a class="btn btn-primary" href={href('/contact')}>Get in touch</a>
  </section>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-categories]'));
  const buttons = bar ? Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-filter]')) : [];
  const count = document.getElementById('filter-count');
  const total = entries.length;

  function apply(filter: string) {
    let shown = 0;
    for (const el of entries) {
      const show = filter === 'all' || (el.dataset.categories ?? '').split(' ').includes(filter);
      el.hidden = !show;
      if (show) shown += 1;
    }
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
    if (count) {
      count.textContent =
        filter === 'all' ? `Showing all ${total} projects` : `Showing ${shown} of ${total} projects in ${filter}`;
    }
  }

  for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter ?? 'all'));
</script>

<style>
  .page-head {
    padding-top: calc(var(--nav-top) + var(--nav-h) + 56px);
  }

  .filter-chip {
    cursor: pointer;
    transition: background-color var(--d2) var(--ease-std), color var(--d2) var(--ease-std);
  }
  .filter-chip:hover { background: var(--color-line); }
  .filter-chip[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-white);
  }

  /* Filtered-out entries must disappear even where a display rule applies. */
  [data-categories][hidden] { display: none !important; }

  .featured-row {
    display: grid;
    gap: 24px;
    padding-block: 40px;
    border-top: 1px solid var(--color-line);
  }
  .featured-row:first-of-type { border-top: 0; }
  @media (min-width: 64rem) {
    .featured-row {
      grid-template-columns: 7fr 5fr;
      gap: 48px;
      align-items: center;
      padding-block: 48px;
    }
  }

  .row-media { display: block; }

  .entry-link {
    color: var(--color-ink);
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    transition: color var(--d1) var(--ease-std);
  }
  .entry-link:hover {
    color: var(--color-primary);
    text-decoration-line: underline;
  }

  .work-grid {
    display: grid;
    gap: 40px 24px;
  }
  @media (min-width: 40rem) {
    .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
