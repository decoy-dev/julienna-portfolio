---
import { Icon } from 'astro-icon/components';
import Mark from './Mark.astro';
import { href } from '../lib/url';
import { person } from '../data/site';

type FLink = { label: string; to: string; external?: boolean };
const all: { title: string; links: FLink[] }[] = [
  {
    title: 'Pages',
    links: [
      { label: 'Home', to: '/' },
      { label: 'Work', to: '/work' },
      { label: 'Brand kit', to: '/brand' },
      { label: 'Contact', to: '/contact' },
    ],
  },
  {
    title: 'Elsewhere',
    links: [
      { label: 'Resume', to: person.resume },
      { label: 'Email', to: `mailto:${person.email}` },
      { label: 'LinkedIn', to: person.linkedin, external: true },
    ],
  },
];
// Links without a real destination yet (see CONTENT-TODO.md) are left out rather than faked.
const columns = all.map((c) => ({ ...c, links: c.links.filter((l) => l.to) }));

/* The logistics a hiring manager asks in the first email. Unknowns stay dashed placeholders until
   Jules fills them in (CONTENT-TODO.md); nothing here is invented. */
const status = [
  { icon: 'ph:calendar-blank', label: 'Availability', placeholder: 'Add availability' },
  { icon: 'ph:timer', label: 'Response time', placeholder: 'Add typical response time' },
  { icon: 'ph:globe-simple', label: 'Time zone', placeholder: 'Add time zone' },
];
---

<footer class="mt-24 border-t border-line bg-surface pt-16 pb-10">
  <div class="shell">
    <section class="status-panel" aria-labelledby="status-title">
      <div class="sp-intro">
        <h2 id="status-title" class="text-h3">Before you email me</h2>
        <p class="mt-2 max-w-[34ch] text-small text-muted">Where I am, when I can start, and how fast I reply.</p>
      </div>
      <dl class="sp-rows">
        {status.map((s) => (
          <div class="sp-row">
            <dt class="flex items-center gap-2 text-small text-muted">
              <Icon name={s.icon} size={18} class="shrink-0" aria-hidden="true" /> {s.label}
            </dt>
            <dd><span class="ph-chip" data-todo="content">{s.placeholder}</span></dd>
          </div>
        ))}
      </dl>
      <div class="sp-actions">
        <a href={`mailto:${person.email}`} class="font-mono text-small text-ink underline-offset-4 hover:text-primary hover:underline wrap-anywhere">{person.email}</a>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn btn-ghost btn-sm" data-copy-email={person.email} hidden>
            <Icon name="ph:copy" size={16} aria-hidden="true" />
            <span data-copy-label aria-live="polite">Copy email</span>
          </button>
          <a href={href(person.resume)} class="btn btn-ghost btn-sm" download>
            <Icon name="ph:download-simple" size={16} aria-hidden="true" /> Download resume
          </a>
        </div>
        {person.linkedin && (
          <a href={person.linkedin} target="_blank" rel="noopener" class="link text-small">
            LinkedIn <Icon name="ph:arrow-up-right" size={14} aria-hidden="true" />
          </a>
        )}
      </div>
    </section>

    <div class="mt-12 grid gap-10 md:grid-cols-[1fr_auto_auto] md:gap-16">
      <div>
        <a href={href('/')} class="inline-flex items-center gap-2 font-display font-semibold text-ink">
          <Mark size={28} /> {person.name}
        </a>
        <p class="mt-4 max-w-[40ch] text-small text-muted">{person.role}. I design the brand, build the site, and automate the production work.</p>
      </div>
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <p class="meta text-muted">{c.title}</p>
          <ul role="list" class="mt-4 grid gap-2">
            {c.links.map((l) => (
              <li>
                <a href={href(l.to)} class="text-small text-ink hover:text-primary" {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="mt-12 border-t border-line pt-6 text-small text-muted">
      © 2026 {person.name}. Built with Astro, Tailwind, and anime.js.
    </p>
  </div>
</footer>

<style>
  .status-panel {
    display: grid;
    gap: 2rem;
    padding: 24px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-bg);
  }
  .sp-rows { display: grid; gap: 1rem; align-content: start; }
  /* Stacked label over value when narrow; one row with the value at the end when there's room. */
  .sp-row { display: grid; gap: 0.5rem; }
  .sp-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .sp-actions .btn { min-height: 44px; }
  @media (min-width: 30rem) {
    .sp-row { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem; }
  }
  @media (min-width: 48rem) {
    .status-panel { padding: 32px; }
    .status-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; }
    .sp-intro { grid-column: 1 / -1; }
  }
  @media (min-width: 64rem) {
    .status-panel { grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr); }
    .sp-intro { grid-column: auto; }
  }
</style>

<script>
  import { wireCopyEmail } from '../scripts/copy-email';

  wireCopyEmail(document.querySelector('footer') ?? document);
</script>
