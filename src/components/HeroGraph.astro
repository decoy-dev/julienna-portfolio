---
import { Icon } from 'astro-icon/components';
import Mark from './Mark.astro';
import { seats } from '../data/site';

const outputs = ['Brand systems', 'Websites', 'Ad sets', 'Motion', 'Renders'];
---

<div class="hero-graph-wrap">
  <div class="hero-graph grid-canvas relative overflow-hidden rounded-media" data-graph data-hero-graph>
    <svg data-edges class="pointer-events-none absolute inset-0 z-[1] size-full" aria-hidden="true">
      {seats.map((s) => <path class="edge" data-role-edge data-from={`${s.id}:out`} data-to="me:in" />)}
      <path class="edge" data-out-edge data-from="me:down" data-to="out:up" />
      {seats.map(() => <circle class="packet" r="3" opacity="0" />)}
      <circle class="packet" data-out-dot r="3.5" opacity="0" />
      <circle class="packet" data-out-dot r="3.5" opacity="0" />
    </svg>

    <ul role="list" class="contents" aria-label="Roles I cover">
      {seats.map((s, i) => (
        <li class="node role-node" data-node={s.id} data-role style={`--i:${i}`}>
          <span class="role-fill" aria-hidden="true" />
          <Icon name={s.icon} size={16} class="relative shrink-0 text-primary" aria-hidden="true" />
          <span class="role-label role-long">{s.label}</span>
          <span class="role-label role-short" aria-hidden="true">{s.short}</span>
          <span class="port" data-side="out" />
        </li>
      ))}
    </ul>

    <div class="node me-node" data-node="me" data-state="active">
      <span class="me-ring" aria-hidden="true" />
      <span class="port" data-side="in" />
      <div class="flex items-center gap-4 px-4 py-4">
        <Mark size={28} class="shrink-0 text-ink" />
        <div class="min-w-0">
          <p class="font-display font-semibold tracking-[-0.01em] text-ink">Julienna Batten</p>
          <p class="me-sub text-small text-muted">Creative director who writes code</p>
        </div>
      </div>
      <span class="port" data-side="down" />
    </div>

    <div class="node out-node" data-node="out" data-state="done">
      <span class="port" data-side="up" />
      <p class="node-head">
        Shipped work <Icon name="ph:check-bold" size={12} class="node-check ml-auto" aria-hidden="true" />
      </p>
      <ul role="list" class="flex flex-wrap gap-2 p-4 pt-2" aria-label="Outputs">
        {outputs.map((o) => <li class="chip out-chip h-6 px-2 text-[0.75rem]" data-out-chip>{o}</li>)}
      </ul>
    </div>

    <button
      type="button"
      class="hero-toggle absolute top-3 right-3 z-[3] grid size-8 place-items-center rounded-full bg-bg text-muted shadow-raised hover:text-ink"
      data-hero-toggle
      aria-label="Pause animation"
      hidden
    >
      <Icon name="ph:pause-fill" size={14} class="icon-pause" aria-hidden="true" />
      <Icon name="ph:play-fill" size={14} class="icon-play" aria-hidden="true" />
    </button>
  </div>
</div>

<style>
  .hero-graph-wrap { container-type: inline-size; }
  .hero-graph { height: 480px; }
  /* Frame hairline sits above the WebGL canvas (an inset shadow would paint beneath it). */
  .hero-graph::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--color-line);
    pointer-events: none;
  }
  .hero-graph :global(.field-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--d4) var(--ease-std);
  }
  .hero-graph :global(.field-canvas.is-ready) { opacity: 1; }

  /* Six roles stacked left, the operator right, output below it. */
  .role-node {
    position: absolute;
    z-index: 2;
    left: 5%;
    top: calc(8% + var(--i) * 13.6%);
    width: 38%;
    height: 44px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 1rem;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
    user-select: none;
  }
  .role-node:hover { border-color: var(--color-graphic-deep); }
  /* Progress fill: a compositor-only scaleX wash behind the label. */
  .role-fill {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--radius-card) - 1.5px);
    background: var(--color-graphic-tint);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }
  .role-label { position: relative; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .role-short { display: none; }
  .me-node { position: absolute; z-index: 2; left: 55%; top: 34%; width: 40%; }
  /* Arrival pulse: a ring outside the border, animated with transform + opacity only. */
  .me-ring {
    position: absolute;
    inset: -1.5px;
    border-radius: var(--radius-card);
    box-shadow: 0 0 0 2px var(--color-graphic-deep);
    opacity: 0;
    pointer-events: none;
  }
  .out-node { position: absolute; z-index: 2; left: 55%; top: 69%; width: 40%; }
  .out-chip { transition: background-color var(--d3) var(--ease-std), box-shadow var(--d3) var(--ease-std); }
  .out-chip[data-lit] {
    background: var(--color-graphic-tint);
    box-shadow: inset 0 0 0 1.5px var(--color-graphic-deep);
    transition-duration: var(--d1);
  }
  .hero-toggle .icon-play { display: none; }
  .hero-toggle[data-paused] .icon-play { display: block; }
  .hero-toggle[data-paused] .icon-pause { display: none; }

  /* Narrow containers keep the same topology with short labels, so every role stays named. */
  @container (max-width: 520px) {
    .hero-graph { height: 440px; }
    .role-node { left: 4%; width: 40%; height: 38px; top: calc(6% + var(--i) * 14.6%); gap: 0.5rem; padding-inline: 0.5rem; font-size: 0.8125rem; }
    .role-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .role-short { display: inline; }
    .me-node { left: 52%; width: 45%; top: 30%; }
    .me-node .px-4 { padding-inline: 1rem; gap: 0.5rem; }
    .me-sub { font-size: 0.75rem; line-height: 1.4; }
    .out-node { left: 52%; width: 45%; top: 64%; }
  }
</style>

<script>
  import { MotionScope, layoutEdges, drawEdge, sendPacket, reducedMotion, watchVisibility } from '../scripts/graph';
  import { mountField } from '../scripts/field';

  const root = document.querySelector<HTMLElement>('[data-hero-graph]');
  if (root) {
    layoutEdges(root);
    const roles = [...root.querySelectorAll<HTMLElement>('[data-role]')];
    const fills = roles.map((r) => r.querySelector<HTMLElement>('.role-fill')!);
    const roleEdges = [...root.querySelectorAll<SVGPathElement>('path[data-role-edge]')];
    const outEdge = root.querySelector<SVGPathElement>('path[data-out-edge]')!;
    const roleDots = [...root.querySelectorAll<SVGCircleElement>('circle.packet:not([data-out-dot])')];
    const outDots = [...root.querySelectorAll<SVGCircleElement>('circle[data-out-dot]')];
    const chips = [...root.querySelectorAll<HTMLElement>('[data-out-chip]')];
    const me = root.querySelector<HTMLElement>('[data-node="me"]')!;
    const ring = me.querySelector<HTMLElement>('.me-ring')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-hero-toggle]')!;
    const field = mountField(root, reducedMotion);

    // Timings (ms). Wide randomization so two roles rarely fire together.
    const FILL = [800, 800]; // base + random
    const HOLD = 120;
    const IDLE = [800, 1600];
    const START_STEP = 420; // first cycles land on shuffled slots 0-2.1s apart
    const ROLE_TRAVEL = 520;
    const OUT_TRAVEL = 480;
    const PULSE_GAP = 300;
    const LAUNCH_GAP = 380; // no two balls ever leave within this window of each other
    const OUT_EVERY = 3;
    const rand = (n: number) => Math.random() * n;
    // Shuffled first-fire order so the roles never start top to bottom.
    const startSlot = roles.map((_, i) => i);
    for (let i = startSlot.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [startSlot[i], startSlot[j]] = [startSlot[j], startSlot[i]];
    }

    let visible = false;
    let paused = false;
    let introStarted = false;
    let introDone = false;
    let running = false;
    let loop = new MotionScope();

    // Per-role live state so pointer input can speed up or trigger a cycle.
    type RoleState = { fillAnim?: { speed: number }; wake?: () => void; flying: boolean };
    const state: RoleState[] = roles.map(() => ({ flying: false }));
    let arrivals = 0;
    let lastPulse = 0;
    let chipIndex = 0;
    let outDot = 0;
    let nextLaunch = 0;

    const resetVisuals = () => {
      for (const f of fills) {
        f.style.transform = 'scaleX(0)';
        f.style.opacity = '1';
      }
      for (const e of roleEdges) e.dataset.state = '';
      outEdge.dataset.state = '';
      for (const c of chips) c.removeAttribute('data-lit');
      ring.style.opacity = '0';
      for (const s of state) s.flying = false;
    };

    const onArrival = (s: MotionScope) => {
      const now = performance.now();
      if (now - lastPulse > PULSE_GAP) {
        lastPulse = now;
        s.animate(ring, { opacity: [0.55, 0], scale: [1, 1.045], duration: 350, ease: 'out(3)' });
      }
      if (++arrivals % OUT_EVERY) return;
      outEdge.dataset.state = 'active';
      sendPacket(s, outEdge, outDots[outDot++ % outDots.length], OUT_TRAVEL).then(() => {
        if (!s.alive) return;
        outEdge.dataset.state = '';
        const chip = chips[chipIndex++ % chips.length];
        chip.setAttribute('data-lit', '');
        s.wait(450).then(() => chip.removeAttribute('data-lit'));
      });
    };

    /** Interruptible idle: resolves early when the pointer wakes this role. */
    const idle = (s: MotionScope, i: number, ms: number) => {
      const { promise, resolve } = Promise.withResolvers<void>();
      state[i].wake = resolve;
      s.wait(ms).then(resolve);
      return promise.then(() => (state[i].wake = undefined));
    };

    const cycle = async (s: MotionScope, i: number) => {
      await idle(s, i, startSlot[i] * START_STEP + rand(260));
      while (s.alive) {
        const run = s.animation(fills[i], { scaleX: [0, 1], opacity: 1, duration: FILL[0] + rand(FILL[1]), ease: 'inOut(2)' });
        state[i].fillAnim = run.anim;
        if (run.anim && roles[i].matches(':hover')) run.anim.speed = 2.5;
        await run.done;
        state[i].fillAnim = undefined;
        if (!s.alive) return;
        await s.wait(HOLD);
        if (!s.alive) return; // a stop during the hold must not re-light the edge
        // Reserve the next free launch slot, then wait for it; this spaces the balls out even when
        // two fills happen to finish together.
        const at = Math.max(performance.now(), nextLaunch);
        nextLaunch = at + LAUNCH_GAP;
        if (at > performance.now()) await s.wait(at - performance.now());
        if (!s.alive) return;
        s.animate(fills[i], { opacity: 0, duration: 200, ease: 'linear' });
        state[i].flying = true;
        roleEdges[i].dataset.state = 'active';
        await sendPacket(s, roleEdges[i], roleDots[i], ROLE_TRAVEL);
        state[i].flying = false;
        if (!s.alive) return;
        roleEdges[i].dataset.state = ''; // back to grey; the stroke transition fades it
        onArrival(s);
        fills[i].style.transform = 'scaleX(0)';
        fills[i].style.opacity = '1';
        await idle(s, i, IDLE[0] + rand(IDLE[1]));
      }
    };

    const canRun = () => visible && !paused && !document.hidden && !reducedMotion.matches;

    const start = () => {
      running = true;
      loop = new MotionScope();
      roles.forEach((_, i) => cycle(loop, i));
    };
    const stop = () => {
      running = false;
      loop.cancel(); // stops fills and packets already in flight, not just future ones
      resetVisuals();
    };

    /** Final, readable state: every wire drawn, operator active, nothing in flight. */
    const settle = () => {
      stop();
      me.dataset.state = 'active';
      introStarted = true; // a settled intro never starts again
      introDone = true;
    };

    /** One place decides whether anything moves; every condition change routes through here. */
    const sync = () => {
      toggle.hidden = reducedMotion.matches;
      field?.suspend(!canRun());
      // An intro that loses permission settles instead of finishing unseen; it never replays.
      if (introStarted && !introDone && !canRun()) settle();
      if (reducedMotion.matches && !introDone) settle();
      if (!introStarted && canRun()) intro();
      const go = introDone && canRun();
      if (go && !running) start();
      if (!go && running) stop();
    };

    const intro = async () => {
      introStarted = true;
      // The intro owns a fresh scope; whoever cancels it (settle) also sets the final state, so a
      // cancelled intro just exits and can never cancel loops started after it.
      const s = (loop = new MotionScope());
      for (const e of roleEdges) e.dataset.state = '';
      await Promise.all(roleEdges.map((p, i) => drawEdge(s, p, 560, 120 + i * 70)));
      if (!s.alive) return;
      for (const e of roleEdges) e.dataset.state = '';
      const box = root.getBoundingClientRect();
      const mb = me.getBoundingClientRect();
      field?.ripple(mb.left - box.left + mb.width / 2, mb.top - box.top + mb.height / 2);
      await drawEdge(s, outEdge, 380);
      if (!s.alive) return;
      introDone = true;
      sync();
    };

    // Pointer reactivity: purely decorative, never restarts a paused or reduced-motion graph.
    roles.forEach((role, i) => {
      role.addEventListener('pointerenter', () => {
        if (!running) return;
        const st = state[i];
        if (st.fillAnim) st.fillAnim.speed = 2.5;
        else if (st.wake && !st.flying) st.wake();
      });
      role.addEventListener('click', () => {
        if (!running) return;
        const st = state[i];
        if (st.fillAnim) st.fillAnim.speed = 12;
        else if (st.wake && !st.flying) st.wake();
      });
    });

    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.toggleAttribute('data-paused', paused);
      toggle.setAttribute('aria-label', paused ? 'Resume animation' : 'Pause animation');
      if (paused && !introDone) settle();
      sync();
    });
    watchVisibility(root, (v) => {
      visible = v;
      sync();
    }, 0.1);
    document.addEventListener('visibilitychange', sync);
    reducedMotion.addEventListener('change', sync);
    sync();
  }
</script>
