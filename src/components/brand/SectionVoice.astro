---
import Guide from './Guide.astro';
import DoDont from './DoDont.astro';

const banned = [
  'streamline',
  'empower',
  'supercharge',
  'leverage',
  'unleash',
  'transform',
  'seamless',
  'elevate',
  'cutting-edge',
  'world-class',
  'next-gen',
  'game-changer',
];
---

<Guide
  id="voice"
  title="Voice and copy"
  intro="First person, plain, and specific, with a little warmth from what I choose to say. The full guide with before-and-after rewrites is VOICE.md in the repo."
>
  <div class="rounded-card border border-line">
    <div class="voice-row">
      <p class="text-small font-semibold">Punctuation</p>
      <p class="text-small text-muted">
        Zero em dashes and zero en dashes, anywhere. Use commas, colons, periods, parentheses, or hyphen ranges (2019-2022).
      </p>
    </div>
    <div class="voice-row">
      <p class="text-small font-semibold">Headlines</p>
      <p class="text-small text-muted">Sentence case, eight words or fewer, balanced wrapping. Sub-paragraphs stay under 25 words and 65ch.</p>
    </div>
    <div class="voice-row">
      <p class="text-small font-semibold">One label per intent</p>
      <p class="text-small text-muted">
        Contact is always "Get in touch". The portfolio is always "See the work". A project link is always "View project". Never synonyms.
      </p>
    </div>
    <div class="voice-row">
      <p class="text-small font-semibold">Numbers</p>
      <p class="text-small text-muted">
        Only verified figures ship unmarked. Anything unconfirmed wears the dashed placeholder chip. Placeholders never carry fake data.
      </p>
    </div>
    <div class="voice-row">
      <p class="text-small font-semibold">Point of view</p>
      <p class="text-small text-muted">First person, always: this is Julienna's own site. "I built", "my pipelines", "email me". Never "she", "her", or "Jules does".</p>
    </div>
    <div class="voice-row">
      <p class="text-small font-semibold">Names</p>
      <p class="text-small text-muted">"Julienna Batten" only as identity: nav lockup, page titles, the operator node. Client names only when real; otherwise "Sample" labels.</p>
    </div>
    <div class="voice-row">
      <p class="text-small font-semibold">Sentence shapes</p>
      <p class="text-small text-muted">No triads or parallel repetition ("AI drafts. Rules decide."), no "X, not Y" headlines, no all-caps eyebrows above headings. Tie each fact to what it did.</p>
    </div>
    <div class="voice-row">
      <p class="text-small font-semibold">Small labels</p>
      <p class="text-small text-muted">Sentence-case sans everywhere (the .meta class). No uppercase, no tracked lettering. Mono is only for literal file names, paths, and code.</p>
    </div>
    <div class="voice-row">
      <p class="text-small font-semibold">Banned words</p>
      <p class="flex flex-wrap gap-x-3 gap-y-1">
        {banned.map((w) => (
          <span class="text-[0.75rem] font-medium text-dash-ink line-through">{w}</span>
        ))}
      </p>
    </div>
  </div>

  <DoDont topic="sentence shape">
    <div slot="do"><p>"Around 40 practices each need eight ad files per campaign, so I built these to start every job from rules instead of a blank artboard."</p></div>
    <div slot="dont"><p>"Two pipelines that ship real work: one input goes in, a finished library comes out."</p></div>
  </DoDont>
  <DoDont topic="claims">
    <div slot="do"><p>"One brand system runs ad campaigns for ~40 practices."</p></div>
    <div slot="dont"><p>"An innovative solution delighting dozens of happy clients."</p></div>
  </DoDont>
  <DoDont topic="placeholders">
    <div slot="do"><p>"hours saved per year" with a dashed <span class="ph-chip">Add number</span> chip where the digits will sit.</p></div>
    <div slot="dont"><p>"10,000+ hours saved" when nobody has measured it.</p></div>
  </DoDont>
  <DoDont topic="labels">
    <div slot="do"><p>"Get in touch" on the nav, the hero, the closing band, and the contact page.</p></div>
    <div slot="dont"><p>"Reach out" here, "Say hi" there, "Contact me" somewhere else. One intent, one label.</p></div>
  </DoDont>
</Guide>

<style>
  .voice-row {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding: 0.875rem 1.25rem;
  }
  .voice-row + .voice-row { border-top: 1px solid var(--color-line); }
  @media (min-width: 48rem) {
    .voice-row { grid-template-columns: 170px minmax(0, 1fr); }
  }
</style>
