---
import { Icon } from 'astro-icon/components';
import Guide from './Guide.astro';
import Spec from './Spec.astro';
import Mark from '../Mark.astro';
import Slot from '../Slot.astro';
---

<Guide
  id="components"
  title="Components"
  intro="Every interactive part, rendered live from the shipped classes. Copy the markup; never restyle a variant in place."
>
  <div class="grid gap-4 lg:grid-cols-2">
    <Spec label=".btn .btn-primary / .btn-ghost / .btn-sm" note="Pills, one height scale: 44px, 36px small. Hover shifts fill in 120ms; press nudges 1px.">
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn btn-primary">Get in touch</button>
        <button type="button" class="btn btn-ghost">See the work <Icon name="ph:arrow-right" size={16} class="btn-arrow" aria-hidden="true" /></button>
        <button type="button" class="btn btn-primary btn-sm">Get in touch</button>
        <button type="button" class="btn btn-ghost btn-sm">Replay</button>
      </div>
      <p class="mt-4 text-small text-muted">Focus draws the global 2px graphic-deep ring at 3px offset. There is no disabled variant; remove the action instead.</p>
    </Spec>
    <Spec label=".btn-invert / .btn-outline-invert" note="Only on ink bands (closing CTA). White pill leads; outline follows." class="grid-canvas-ink">
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn btn-invert">Get in touch</button>
        <button type="button" class="btn btn-outline-invert">Download resume</button>
      </div>
    </Spec>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <Spec label=".link + .link-arrow" note="Inline action. Primary color, underline on hover, arrow nudges 3px.">
      <a href="#components" class="link">View project <Icon name="ph:arrow-right" size={16} class="link-arrow" aria-hidden="true" /></a>
    </Spec>
    <Spec label=".chip / .ph-chip" note="Chips are facts. Dashed chips are missing facts, never fake ones.">
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip">+25% online sales</span>
        <span class="chip">~40 practices</span>
        <span class="ph-chip">add number</span>
        <span class="ph-chip">add logo</span>
      </div>
    </Spec>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <Spec label='<Slot ratio brief radius? />' note="Every self-provided image ships as a slot until the real asset lands." pad={false}>
      <div class="p-4">
        <Slot ratio="16 / 10" brief="Wide project image, 16:10, swap for the final export" radius="card" />
      </div>
    </Spec>
    <Spec label="stat" note="Stat number in tabular numerals; the label sits under it in small muted.">
      <div class="grid grid-cols-2 gap-6">
        <div>
          <p class="text-stat tabular-nums">+25%</p>
          <p class="mt-1 text-small text-muted">online sales in two quarters, Wincore</p>
        </div>
        <div>
          <p class="text-stat tabular-nums text-dash-ink">000</p>
          <p class="mt-1 flex flex-wrap items-center gap-1.5 text-small text-muted">hours saved per year <span class="ph-chip">add number</span></p>
        </div>
      </div>
    </Spec>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <Spec label="nav pill" note="Static specimen. The real one is src/components/Nav.astro: fixed, frosted, e2." class="bg-surface" pad={true}>
      <div class="inline-flex max-w-full items-center gap-4 rounded-full bg-white py-2 pr-2 pl-4 shadow-float">
        <span class="flex items-center gap-2">
          <Mark size={24} />
          <span class="text-small font-[650] tracking-[-0.015em] whitespace-nowrap">Julienna Batten</span>
        </span>
        <span class="hidden items-center gap-4 text-small text-muted sm:flex">
          <span>Work</span><span>Systems</span><span class="text-ink font-medium">About</span>
        </span>
        <span class="btn btn-primary btn-sm">Get in touch</span>
      </div>
    </Spec>
    <Spec label="segmented control" note="Surface-2 track, white active pill on shadow-raised, 200ms. Try it.">
      <div class="seg" role="tablist" aria-label="Pipeline picker" data-seg>
        <button type="button" role="tab" aria-selected="true" class="seg-btn">ad-generator</button>
        <button type="button" role="tab" aria-selected="false" class="seg-btn">photo-intake</button>
      </div>
    </Spec>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <Spec label="input + label + helper" note="Label above, always. Helper below. No placeholder-as-label.">
      <div class="grid max-w-[360px] gap-1.5">
        <label class="text-small font-semibold" for="spec-email">Email</label>
        <input class="field" type="email" id="spec-email" autocomplete="off" />
        <p class="text-small text-muted">Replies within two business days.</p>
      </div>
      <div class="mt-5 grid max-w-[360px] gap-1.5">
        <label class="text-small font-semibold" for="spec-email-err">Email</label>
        <input class="field field-error" type="email" id="spec-email-err" autocomplete="off" aria-invalid="true" aria-describedby="spec-email-err-msg" />
        <p id="spec-email-err-msg" class="flex items-center gap-1.5 text-small font-medium text-danger">
          <Icon name="ph:warning-circle" size={16} aria-hidden="true" /> Enter an email address.
        </p>
      </div>
    </Spec>
    <div class="grid gap-4">
      <Spec label=".node" note="1.5px border, mono title bar, ports only where wired." class="grid-canvas">
        <div class="node relative inline-block w-[170px]">
          <div class="node-bar">rename-tag <Icon name="ph:check" size={14} class="node-check ml-auto" aria-hidden="true" /></div>
          <div class="px-3 py-2 font-mono text-[0.6875rem] text-muted">312 files</div>
        </div>
      </Spec>
      <Spec label=".window" note="App frame for pipeline stages: card radius, 1px line border, mono chrome title." pad={false}>
        <div class="window">
          <div class="flex h-9 items-center border-b border-line bg-surface px-3 font-mono text-[0.6875rem] tracking-[0.06em] text-muted uppercase">photo-intake.pipeline</div>
          <div class="grid-canvas h-20"></div>
        </div>
      </Spec>
    </div>
  </div>
</Guide>

<style>
  .seg {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-inset);
    background: var(--color-surface-2);
  }
  .seg-btn {
    padding: 0.375rem 0.875rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    transition: background-color var(--d2) var(--ease-std), color var(--d2) var(--ease-std), box-shadow var(--d2) var(--ease-std);
  }
  .seg-btn[aria-selected='true'] {
    background: var(--color-white);
    color: var(--color-ink);
    box-shadow: var(--shadow-raised);
  }
  .field {
    height: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-inset);
    border: 1.5px solid var(--color-line);
    background: var(--color-bg);
    font-size: var(--text-small);
    color: var(--color-ink);
    transition: border-color var(--d1) var(--ease-std);
  }
  .field:hover { border-color: var(--color-dash-ink); }
  .field-error { border-color: var(--color-danger); }
</style>

<script>
  for (const seg of document.querySelectorAll<HTMLElement>('[data-seg]')) {
    const tabs = [...seg.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    seg.addEventListener('click', (e) => {
      const hit = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (!hit) return;
      for (const t of tabs) t.setAttribute('aria-selected', String(t === hit));
    });
  }
</script>
