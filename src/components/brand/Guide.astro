---
/** One /brand guide section: anchor target, heading, optional intro, content flow. */
interface Props {
  id: string;
  title: string;
  intro?: string;
}
const { id, title, intro } = Astro.props;
---

<section id={id} data-guide-section aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-h2">{title}</h2>
  {intro && <p class="mt-4 max-w-[65ch] text-body text-muted">{intro}</p>}
  <div class="mt-8 grid gap-10">
    <slot />
  </div>
</section>
