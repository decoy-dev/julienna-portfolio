---
/**
 * "jb" monogram built from motif primitives: the shared stem is an edge, its terminals are ports,
 * the b bowl is the node boundary. Geometry is fixed; see DESIGN.md → Mark.
 */
interface Props {
  size?: number;
  tile?: boolean;
  class?: string;
}
const { size = 28, tile = false, class: className } = Astro.props;
const stroke = tile ? 'var(--color-white)' : 'currentColor';
const port = tile ? 'var(--color-graphic-tint)' : 'var(--color-graphic)';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
>
  {tile && <rect width="40" height="40" rx="10" fill="var(--color-primary)" />}
  <g stroke={stroke} stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" transform="translate(1 -1.6)">
    <path d="M18 9V29" />
    <path d="M18 16.5C23.5 16.5 29 18.2 29 22.3C29 26.4 23.5 28 18 28" />
    <path d="M18 29C18 33.5 15.5 35.2 12 34.2" />
  </g>
  <g fill={port} stroke={tile ? 'var(--color-primary)' : 'var(--color-bg)'} stroke-width="1.2" transform="translate(1 -1.6)">
    <circle cx="18" cy="9" r="2.6" />
    <circle cx="12" cy="34.2" r="2.6" />
  </g>
</svg>
