---
import { Icon } from 'astro-icon/components';
import { href } from '../lib/url';
import { person } from '../data/site';
---

<section class="pb-8" aria-labelledby="cta-title">
  <div class="shell">
    <div class="cta grid-canvas-ink relative overflow-hidden rounded-media px-6 py-16 text-center md:px-12 md:py-24" data-cta>
      <!-- The wire enters from the left edge and terminates behind the primary button. On desktop the
           page wire (PageWire.astro) arrives at this edge, so this line is its final segment. -->
      <svg class="cta-wire pointer-events-none absolute inset-0 size-full" aria-hidden="true">
        <line class="cta-line" x1="0" y1="0" x2="0" y2="0" />
      </svg>
      <h2 id="cta-title" class="relative mx-auto max-w-[18ch] text-h2 text-white">Let's build something reusable</h2>
      <p class="relative mx-auto mt-4 max-w-[44ch] text-body text-on-ink-muted">If you're hiring for brand, web, or creative direction, I'd like to hear about it.</p>
      <div class="relative mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={href('/contact')} class="btn btn-invert" data-cta-sink>Get in touch <Icon name="ph:arrow-right" size={16} class="btn-arrow" aria-hidden="true" /></a>
        <a href={href(person.resume)} class="btn btn-outline-invert" download>
          <Icon name="ph:download-simple" size={16} aria-hidden="true" /> Download resume
        </a>
      </div>
      <a href={`mailto:${person.email}`} class="relative mt-7 inline-block font-mono text-small text-on-ink-muted underline-offset-4 hover:text-white hover:underline">{person.email}</a>
    </div>
  </div>
</section>

<style>
  .cta-wire { display: none; }
  @media (min-width: 40rem) { .cta-wire { display: block; } }
  .cta-line { stroke: oklch(0.72 0.1 188 / 0.55); stroke-width: 1.5; }
</style>

<script>
  // Keep the panel's wire at the primary button's midline; it is the end of the page wire.
  const cta = document.querySelector<HTMLElement>('[data-cta]');
  const sink = cta?.querySelector<HTMLElement>('[data-cta-sink]');
  const line = cta?.querySelector<SVGLineElement>('.cta-line');
  if (cta && sink && line) {
    new ResizeObserver(() => {
      const c = cta.getBoundingClientRect();
      const b = sink.getBoundingClientRect();
      const y = (b.top - c.top + b.height / 2).toFixed(1);
      line.setAttribute('y1', y);
      line.setAttribute('y2', y);
      line.setAttribute('x2', (b.left - c.left + b.width / 2).toFixed(1));
    }).observe(cta);
  }
</script>
