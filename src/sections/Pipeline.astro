---
import CountUp from '../components/CountUp.astro';
import { Icon } from 'astro-icon/components';
import AdFrame from '../components/AdFrame.astro';
import { personas, templates } from '../data/site';

const persona = personas[0]; // Dr. V. Frizzle; Replay advances through the other ten
const client = 'SamplePractice'; // stand-in; client names stay private

/* Lane A: four choices merge into one render, which fans out into the 8-file matrix. The first
   three inputs are picked from a set, drawn as a small deck behind the node. */
type Input = { id: string; icon: string; title: string; value: string; sub?: string; count?: string };
const inputs: Input[] = [
  { id: 'persona', icon: 'ph:user-circle', title: 'Persona', value: persona.name, sub: persona.archetype, count: `1 of ${personas.length}` },
  { id: 'kit', icon: 'ph:swatches', title: 'Brand kit', value: client, count: '1 of ~40' },
  { id: 'template', icon: 'ph:layout', title: 'Template', value: 'Split Stack', count: `1 of ${templates.length}` },
  { id: 'content', icon: 'ph:text-aa', title: 'Content', value: 'Copy, photo, logo' },
];

// Real deliverable matrix: V1/V2 x Story/Post x Image/Video = 8 files per practice per campaign.
const deliverables = (['V1', 'V2'] as const).flatMap((v) =>
  (['Story', 'Post'] as const).flatMap((size) =>
    (['Image', 'Video'] as const).map((type) => ({ v, size, type, name: `Seasonal_Summer-2026_${type}_${v}_${size}_${client}` })),
  ),
);
const lastAd = deliverables.at(-1)!.name;

/* Lane B: a loose field of raw frames drains through two gates into four bins. The scatter is
   seeded so every build renders the same field; 8 tiles are rejects, the 16 keepers deal into
   the bins in turn. */
const folders = [
  { dir: 'web', file: 'hero_2400w.webp' },
  { dir: 'ads', file: 'story_1080x1920.jpg' },
  { dir: 'social', file: 'post_1080x1350.jpg' },
  { dir: 'print', file: 'brochure_300dpi.tif' },
];
const lastPhoto = `library/${folders.at(-1)!.dir}/${folders.at(-1)!.file}`;
const COLS = 6;
const ROWS = 4;
const REJECTS = new Set([1, 4, 8, 11, 14, 17, 19, 22]);
let seed = 11;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
let kept = 0;
const tiles = Array.from({ length: COLS * ROWS }, (_, i) => {
  const c = i % COLS;
  const r = Math.floor(i / COLS);
  const reject = REJECTS.has(i);
  return {
    x: (4 + ((c + 0.2 + rand() * 0.6) / COLS) * 84).toFixed(1),
    y: (14 + ((r + 0.2 + rand() * 0.6) / ROWS) * 80).toFixed(1),
    rot: (rand() * 8 - 4).toFixed(1),
    photo: i % 3 === 0,
    reject,
    k: reject ? 0 : kept++,
  };
});
// Floating ports the feed edges leave from: right edge on wide lanes, bottom edge when stacked.
const anchors = [22, 41, 60, 79];
const personaData = JSON.stringify(personas.map((p, i) => ({ name: p.name, type: p.archetype, color: p.color, count: `${i + 1} of ${personas.length}` })));
---

<section id="systems" class="relative py-[clamp(80px,12vh,128px)]" data-wire-section aria-labelledby="systems-title">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
      <div>
        <h2 id="systems-title" class="max-w-[20ch] text-h2">Two pipelines I built, and what they produce</h2>
        <p class="mt-4 max-w-[58ch] text-body text-muted">
          I built the ad generator for campaigns across around 40 practices, and the photo intake pipeline to turn client shoots into production-ready libraries.
        </p>
      </div>
      <button type="button" class="pl-replay btn btn-ghost btn-sm" data-replay hidden>
        <Icon name="ph:arrow-counter-clockwise" size={16} aria-hidden="true" /> Replay pipelines
      </button>
    </div>

    <div class="window mt-10" data-pipelines>
      <!-- Lane A: ad generator -->
      <section class="lane" aria-labelledby="lane-ads" data-lane="ads" data-personas={personaData}>
        <div class="lane-head">
          <h3 id="lane-ads" class="text-h3">Ad generator</h3>
          <p class="text-small text-muted">Four choices go in, and fixed rules render every size and version from them.</p>
          <span class="ph-chip">Sample brand kit</span>
        </div>

        <div class="lane-graph lg-ads grid-canvas" data-graph>
          <svg data-edges class="pointer-events-none absolute inset-0 z-[1] size-full" aria-hidden="true">
            {inputs.map((input, i) => (
              <path class="edge" data-state="done" data-feed data-from={`ads-${input.id}:out`} data-to="ads-render:in" data-from-compact={`ads-${input.id}:${i % 2 ? 'in' : 'out'}`} data-to-compact="ads-render:up" data-route-compact="elbow" />
            ))}
            <path class="edge" data-state="done" data-link data-from="ads-render:out" data-to="ads-out:in" data-from-compact="ads-render:down" data-to-compact="ads-out:up" />
            {inputs.map(() => <circle class="packet" r="3" opacity="0" />)}
          </svg>

          <ol class="ads-inputs" aria-label="Render inputs">
            {inputs.map((input) => (
              <li class="ads-input" data-deck={input.count ? '' : undefined}>
                {input.count && <><span class="deck-card deck-2" aria-hidden="true" /><span class="deck-card deck-1" aria-hidden="true" /></>}
                <div class="node ads-in-node" data-node={`ads-${input.id}`} data-stage data-input data-state="done">
                  <Icon name={input.icon} size={18} class="in-icon text-primary" aria-hidden="true" />
                  <span class="min-w-0">
                    <span class="flex items-baseline gap-2">
                      <span class="text-meta text-ink">{input.title}</span>
                      {input.count && <span class="in-count ml-auto shrink-0 text-[0.75rem] text-muted" data-persona-count={input.id === 'persona' ? '' : undefined}>{input.count}</span>}
                    </span>
                    <span class="block truncate text-[0.75rem] leading-snug text-ink" data-persona-name={input.id === 'persona' ? '' : undefined}>{input.value}</span>
                    {input.sub && <span class="in-sub block truncate text-[0.75rem] leading-snug text-muted" data-persona-type>{input.sub}</span>}
                  </span>
                  <span class="port feed-port" />
                </div>
              </li>
            ))}
          </ol>

          <div class="node ads-render" data-node="ads-render" data-stage data-render data-state="done">
            <span class="port r-in" />
            <Icon name="ph:cpu" size={20} class="shrink-0 text-primary" aria-hidden="true" />
            <span>
              <span class="block text-meta text-ink">Render</span>
              <span class="block text-[0.75rem] leading-snug text-muted">Fixed rules</span>
            </span>
            <Icon name="ph:check-bold" size={12} class="node-check ml-auto shrink-0" aria-hidden="true" />
            <span class="port r-out" />
          </div>

          <div class="node lane-out" data-node="ads-out" data-output data-state="done" style={`--persona:${persona.color}`}>
            <span class="port out-in" />
            <p class="node-head">8 files for one practice <Icon name="ph:check-bold" size={12} class="node-check ml-auto" aria-hidden="true" /></p>
            <div class="px-3.5 pt-3 pb-3.5">
              <ul role="list" class="out-frames" aria-label="The 8 deliverables">
                {(['V1', 'V2'] as const).map((v) => (
                  <li class="out-group">
                    <span class="out-v" aria-hidden="true">{v}</span>
                    <ul role="list" class="out-row">
                      {deliverables.filter((d) => d.v === v).map((d) => (
                        <li class="out-item" data-item data-state="done" data-name={d.name}>
                          <AdFrame size={d.size} color={persona.color} />
                          <Icon name={d.type === 'Video' ? 'ph:film-strip' : 'ph:image'} size={11} class="mx-auto mt-1 text-muted" aria-hidden="true" />
                          <span class="sr-only">{d.v} {d.size} {d.type}</span>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
              <p class="mt-3 flex items-center gap-2">
                <span class="min-w-0 flex-1 font-mono text-[0.6875rem] wrap-anywhere text-ink" data-ticker data-idle="Waiting for render" data-final={lastAd} aria-hidden="true">{lastAd}</span>
                <span class="sr-only">Example file name: {lastAd}</span>
                <span class="ph-chip">Illustrative</span>
              </p>
              <p class="mt-2 text-[0.8125rem] text-muted"><CountUp text="About 320 files per campaign" /> across ~40 practices.</p>
              <span class="ph-chip mt-1.5" data-todo="verify">Estimate, verify</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Lane B: photo intake -->
      <section class="lane" aria-labelledby="lane-photos" data-lane="photos">
        <div class="lane-head">
          <h3 id="lane-photos" class="text-h3">Photo intake</h3>
          <p class="text-small text-muted">A raw client shoot goes in, and an organized library comes out.</p>
          <span class="ph-chip" data-todo="verify">Example steps and folders</span>
        </div>

        <div class="lane-graph lg-photos grid-canvas" data-graph>
          <svg data-edges class="pointer-events-none absolute inset-0 z-[1] size-full" aria-hidden="true">
            {anchors.map((_, i) => (
              <path class="edge" data-state="done" data-feed data-from={`ph-a${i}:out`} data-to="ph-cull:in" data-from-compact={`ph-a${i}:down`} data-to-compact="ph-cull:up" />
            ))}
            <path class="edge" data-state="done" data-gate-edge data-from="ph-cull:down" data-to="ph-name:up" />
            <path class="edge" data-state="done" data-link data-from="ph-name:out" data-to="photos-out:in" data-from-compact="ph-name:down" data-to-compact="photos-out:up" />
            {anchors.map(() => <circle class="packet" r="3" opacity="0" />)}
          </svg>

          <div class="field" data-field data-phase="sorted">
            <p class="meta relative z-[3] text-muted">Raw shoot, unsorted</p>
            <div aria-hidden="true">
              {tiles.map((t) => (
                <span class="tile" data-reject={t.reject ? '' : undefined} style={`left:calc(${t.x}% - 17px);top:calc(${t.y}% - 13px);rotate:${t.rot}deg;--k:${t.k};--bin:${t.k % folders.length}`}>
                  {t.photo && <Icon name="ph:image" size={13} />}
                </span>
              ))}
              {anchors.map((a, i) => <span class="anchor" data-node={`ph-a${i}`} style={`--a:${a}%`} />)}
            </div>
          </div>

          <ol class="ph-gates" aria-label="Photo intake steps">
            <li class="node lane-step" data-node="ph-cull" data-stage data-cull data-state="done">
              <span class="port g-in" />
              <Icon name="ph:funnel" size={18} class="shrink-0 text-primary" aria-hidden="true" />
              <span class="min-w-0">
                <span class="block text-meta text-ink">Cull</span>
                <span class="block text-[0.75rem] leading-snug text-muted">Selects kept</span>
              </span>
              <Icon name="ph:check-bold" size={12} class="node-check ml-auto shrink-0" aria-hidden="true" />
              <span class="port" data-side="down" />
            </li>
            <li class="node lane-step" data-node="ph-name" data-stage data-namer data-state="done">
              <span class="port" data-side="up" />
              <Icon name="ph:tag" size={18} class="shrink-0 text-primary" aria-hidden="true" />
              <span class="min-w-0">
                <span class="block text-meta text-ink">Name</span>
                <span class="block text-[0.75rem] leading-snug text-muted">One convention</span>
              </span>
              <Icon name="ph:check-bold" size={12} class="node-check ml-auto shrink-0" aria-hidden="true" />
              <span class="port g-out" />
            </li>
          </ol>

          <div class="node lane-out" data-node="photos-out" data-output data-state="done">
            <span class="port out-in" />
            <p class="node-head">Production library <Icon name="ph:check-bold" size={12} class="node-check ml-auto" aria-hidden="true" /></p>
            <div class="px-3.5 pt-3 pb-3.5">
              <ul role="list" class="grid gap-2" aria-label="Library folders">
                {folders.map((f) => (
                  <li class="out-item out-folder" data-item data-state="done" data-name={`library/${f.dir}/${f.file}`}>
                    <Icon name="ph:folder-simple" size={16} class="shrink-0 text-primary" aria-hidden="true" />
                    <span class="w-14 font-mono text-[0.75rem] text-ink">/{f.dir}</span>
                    <span class="out-thumbs" aria-hidden="true">{Array.from({ length: 4 }, () => <span />)}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-3 flex items-center gap-2">
                <span class="min-w-0 flex-1 font-mono text-[0.6875rem] wrap-anywhere text-ink" data-ticker data-idle="Waiting for the shoot" data-final={lastPhoto} aria-hidden="true">{lastPhoto}</span>
                <span class="sr-only">Example file path: {lastPhoto}</span>
                <span class="ph-chip">Illustrative</span>
              </p>
            </div>
          </div>
        </div>
      </section>

      <dl class="pl-results">
        <div><dt class="meta text-muted">Per practice, per campaign</dt><dd>8 deliverables: V1 and V2, Story and Post, static and animated</dd></div>
        <div><dt class="meta text-muted">Ships alongside</dt><dd>A matching site template with nav, hero, and footer</dd></div>
        <div><dt class="meta text-muted">Production time per campaign</dt><dd><span class="ph-chip" data-todo="metric">Add before</span> <Icon name="ph:arrow-right" size={12} class="inline text-muted" aria-label="to" /> <span class="ph-chip" data-todo="metric">Add after</span></dd></div>
        <div><dt class="meta text-muted">Hours per photo shoot</dt><dd><span class="ph-chip" data-todo="metric">Add before</span> <Icon name="ph:arrow-right" size={12} class="inline text-muted" aria-label="to" /> <span class="ph-chip" data-todo="metric">Add after</span></dd></div>
      </dl>
      <p class="sr-only" role="status" data-status></p>
    </div>
    <p class="mt-4 text-small text-muted">
      The ad generator steps match the tool I use at OrthoBoost. Practice names, file names, and the photo intake steps are stand-ins, since client work stays private.
    </p>
  </div>
</section>

<style>
  .lane + .lane { border-top: 1px solid var(--color-line); }
  .lane-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 1.25rem 1.5rem 0;
  }
  .lane-head h3 { font-size: 1.125rem; }
  .lane-head .ph-chip { align-self: center; }

  /* The lane is the size container; the graph inside it switches layout (a container can't
     query itself). */
  .lane { container-type: inline-size; }
  .lane-graph {
    position: relative;
    display: grid;
    gap: 48px;
    align-items: center;
    padding: 1.5rem;
    background-color: transparent;
  }
  .lane-graph > :not(svg) { position: relative; z-index: 2; }
  .lg-ads { grid-template-columns: minmax(0, 288px) minmax(176px, 1fr) minmax(280px, 344px); }
  .lg-photos { grid-template-columns: minmax(0, 1.15fr) 200px minmax(280px, 344px); }

  /* Shared node pieces */
  .lane-step { display: flex; align-items: center; gap: 0.5rem; min-height: 56px; padding: 0.5rem 0.75rem; }
  .out-in, .r-in, .g-in { left: var(--port-off); top: calc(50% - 4px); }
  .r-out, .g-out, .feed-port { right: var(--port-off); top: calc(50% - 4px); }

  /* Lane A inputs: a column of choices. Picked-from-a-set inputs get a two-card deck behind. */
  .ads-inputs { display: grid; gap: 18px; }
  .ads-input { position: relative; }
  .ads-input[data-deck] { margin-bottom: 6px; }
  .deck-card {
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-bg);
  }
  .deck-1 { translate: 0 4px; scale: 0.965 1; }
  .deck-2 { translate: 0 8px; scale: 0.93 1; }
  .ads-in-node {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.625rem;
    min-height: 60px;
    padding: 0.5rem 0.75rem;
  }
  .ads-render {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: min(176px, 100%);
    min-height: 88px;
    padding: 0.75rem 0.875rem;
  }

  /* 8 files as two labelled sets (V1, V2); in each, Story then Post by aspect, image then video by icon. */
  .out-frames { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .out-v {
    display: block;
    margin-bottom: 6px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .out-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 5px; align-items: end; }
  .out-item { transition: transform var(--d3) var(--ease-out); }
  .out-item :global(:is(.ad-frame, svg)), .out-item .out-thumbs { transition: opacity var(--d3) var(--ease-std); }
  .out-item:not([data-state='done']) :global(:is(.ad-frame, svg)),
  .out-item:not([data-state='done']) .out-thumbs { opacity: 0.3; }
  .out-frames .out-item:not([data-state='done']) { transform: translateY(3px) scale(0.94); }
  .out-folder { display: flex; align-items: center; gap: 0.625rem; }
  .out-thumbs { display: flex; gap: 4px; }
  .out-thumbs span { width: 22px; height: 15px; border-radius: 3px; background: var(--color-graphic-tint); }

  /* Lane B field: loose frames on the canvas, deliberately not a node. */
  .field { align-self: stretch; min-height: 260px; }
  .tile {
    position: absolute;
    display: grid;
    place-items: center;
    width: 34px;
    height: 26px;
    border: 1.5px solid oklch(0.47 0.02 215 / 0.28);
    border-radius: 4px;
    background: var(--color-surface-2);
    color: oklch(0.47 0.02 215 / 0.55);
    transition: opacity var(--d3) var(--ease-std), scale var(--d3) var(--ease-std), border-color var(--d2) var(--ease-std);
  }
  /* The name stamp: keepers take a teal edge and a short bar along the bottom. */
  .tile::after {
    content: "";
    position: absolute;
    inset: auto 4px 3px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-graphic-deep);
    opacity: 0;
    transition: opacity var(--d2) var(--ease-std);
  }
  .field:is([data-phase='culled'], [data-phase='tagged'], [data-phase='sorted']) .tile[data-reject] { opacity: 0.16; scale: 0.85; }
  .field:is([data-phase='tagged'], [data-phase='sorted']) .tile:not([data-reject]) { border-color: var(--color-graphic); transition-delay: calc(var(--k) * 22ms); }
  .field:is([data-phase='tagged'], [data-phase='sorted']) .tile:not([data-reject])::after { opacity: 1; transition-delay: calc(var(--k) * 22ms); }
  /* Sorted keepers stay legible: the field reads as processed, not empty. */
  .field[data-phase='sorted'] .tile:not([data-reject]) { opacity: 0.55; transition-delay: calc(var(--bin) * 90ms); }
  .anchor {
    position: absolute;
    left: calc(100% - 8px);
    top: calc(var(--a) - 4px);
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1.5px var(--color-graphic-deep);
  }
  .ph-gates { display: grid; gap: 56px; }

  .pl-results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .pl-results > div { padding: 1rem 1.25rem; }
  .pl-results > div + div { border-left: 1px solid var(--color-line); }
  .pl-results dd { margin-top: 0.25rem; font-size: var(--text-small); line-height: 1.5; color: var(--color-ink); }

  /* Medium: results in a 2x2 grid. */
  @media (max-width: 63.99rem) {
    .pl-results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pl-results > div:nth-child(3) { border-left: 0; }
    .pl-results > div:nth-child(n + 3) { border-top: 1px solid var(--color-line); }
  }
  @media (max-width: 39.99rem) {
    .pl-results { grid-template-columns: minmax(0, 1fr); }
    .pl-results > div + div { border-left: 0; border-top: 1px solid var(--color-line); }
  }

  /* Stacked lanes. Lane A keeps its merge: a 2x2 input grid whose elbows bundle down the middle
     gutter into Render. Lane B keeps its funnel: the field drains from its bottom edge. */
  @container (max-width: 900px) {
    .lane-graph { --graph-compact: 1; grid-template-columns: minmax(0, 1fr); gap: 32px; padding: 1.25rem 1rem 1.5rem; }
    .ads-inputs { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; row-gap: 22px; }
    .ads-input:nth-child(even) .feed-port { right: auto; left: var(--port-off); }
    .in-sub { display: none; }
    .ads-render { width: min(220px, 100%); min-height: 64px; }
    .r-in, .out-in { left: calc(50% - 4px); top: var(--port-off); }
    .r-out, .g-out { right: auto; top: auto; left: calc(50% - 4px); bottom: var(--port-off); }
    .g-in { left: calc(50% - 4px); top: var(--port-off); }
    .field { min-height: 200px; }
    .tile { width: 28px; height: 21px; translate: 3px 2px; }
    .anchor { left: calc(var(--a) - 4px); top: calc(100% - 8px); }
    .ph-gates { justify-self: center; width: min(220px, 100%); gap: 32px; }
  }
  @container (max-width: 520px) {
    .ads-in-node { grid-template-columns: minmax(0, 1fr); row-gap: 0.25rem; padding-inline: 0.625rem; }
    .in-icon { display: none; }
    .in-count { margin-left: 0; }
    .ads-in-node .flex { flex-wrap: wrap; column-gap: 0.375rem; }
  }
  @container (max-width: 380px) {
    .out-frames { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { layoutEdges, reducedMotion, watchVisibility } from '../scripts/graph';
  import { createAdGenerator, createPhotoIntake } from '../scripts/pipeline';

  const root = document.querySelector<HTMLElement>('[data-pipelines]');
  const replay = document.querySelector<HTMLButtonElement>('[data-replay]');
  const ads = root?.querySelector<HTMLElement>('[data-lane="ads"]');
  const photos = root?.querySelector<HTMLElement>('[data-lane="photos"]');
  if (root && replay && ads && photos) {
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const LANE_OFFSET = 400;
    const DONE: Record<string, string> = {
      ads: 'Ad generator finished: 8 files for one practice.',
      photos: 'Photo intake finished: a production library from one shoot.',
    };
    // Each lane runs on its own: it starts when its own graph is in view (a tall stacked lane
    // may never let the whole window reach a threshold) and settles when it leaves. A lane never
    // runs unseen: replaying an offscreen lane re-arms it to play when it scrolls in.
    const lanes = [
      { el: ads, runner: createAdGenerator(ads) },
      { el: photos, runner: createPhotoIntake(photos) },
    ].map(({ el, runner }) => ({
      el,
      runner,
      graph: el.querySelector<HTMLElement>('[data-graph]')!,
      relayout: layoutEdges(el.querySelector<HTMLElement>('[data-graph]')!),
      started: false,
      inView: false,
      runId: 0,
    }));
    type Lane = (typeof lanes)[number];

    const arm = (lane: Lane) => {
      lane.runId++;
      lane.started = false;
      if (!reducedMotion.matches) lane.runner.reset();
    };
    /** `announce` is for an explicit replay only; autoplay stays silent. */
    const play = (lane: Lane, delay = 0, announce = false) => {
      const id = ++lane.runId;
      lane.started = true;
      lane.relayout();
      // Layout runs in the rAF queued by relayout; the lane starts in the frame after it.
      requestAnimationFrame(async () => {
        if (delay) await new Promise((r) => setTimeout(r, delay));
        if (id !== lane.runId) return;
        if (document.hidden || !lane.inView) return arm(lane);
        if ((await lane.runner.play()) && announce && id === lane.runId) status.textContent = DONE[lane.el.dataset.lane!];
      });
    };
    const settle = (lane: Lane) => {
      if (!lane.started) return; // an armed lane keeps its ready state until it is seen
      lane.runId++;
      lane.runner.finish();
    };

    replay.hidden = false;
    replay.addEventListener('click', () => {
      status.textContent = '';
      lanes.forEach((l, i) => (l.inView ? play(l, i * LANE_OFFSET, true) : arm(l)));
    });
    if (!reducedMotion.matches) lanes.forEach((l) => l.runner.reset());
    for (const lane of lanes) {
      watchVisibility(lane.graph, (visible) => {
        lane.inView = visible;
        if (visible && !lane.started && !document.hidden) play(lane);
      }, 0.45);
      watchVisibility(lane.el, (onScreen) => onScreen || settle(lane), 0);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) return lanes.forEach(settle);
      // Back from a hidden tab: a lane that came into view meanwhile starts now.
      lanes.forEach((l) => l.inView && !l.started && play(l));
    });
  }
</script>
