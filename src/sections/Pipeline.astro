---
import { Icon } from 'astro-icon/components';
import Wire from '../components/Wire.astro';
import AdFrame from '../components/AdFrame.astro';
import { personas } from '../data/site';

const persona = personas[0]; // Dr. V. Frizzle
const client = 'SamplePractice'; // stand-in; client names stay private

type Step = { icon: string; title: string; meta: string };
type Lane = { id: string; title: string; blurb: string; example?: boolean; steps: Step[] };

const lanes: Lane[] = [
  {
    id: 'ads',
    title: 'Ad generator',
    blurb: 'I design the layouts in Figma, and fixed rules render them for every practice.',
    steps: [
      { icon: 'ph:user-circle', title: 'Persona', meta: persona.name },
      { icon: 'ph:swatches', title: 'Brand kit', meta: '1 of ~40' },
      { icon: 'ph:layout', title: 'Template', meta: 'Split Stack' },
      { icon: 'ph:text-aa', title: 'Content', meta: 'Copy, photo, logo' },
      { icon: 'ph:cpu', title: 'Render', meta: 'Rules, no LLM' },
    ],
  },
  {
    id: 'photos',
    title: 'Photo intake',
    blurb: 'A raw client shoot goes in, and an organized library comes out.',
    example: true, // intermediate steps unconfirmed (CONTENT-TODO.md)
    steps: [
      { icon: 'ph:camera', title: 'Raw shoot', meta: 'Unsorted' },
      { icon: 'ph:tray-arrow-down', title: 'Import', meta: 'Backed up' },
      { icon: 'ph:funnel', title: 'Cull', meta: 'Selects kept' },
      { icon: 'ph:tag', title: 'Name', meta: 'One convention' },
      { icon: 'ph:crop', title: 'Prepare', meta: 'Cropped to spec' },
    ],
  },
];

// Real deliverable matrix: V1/V2 x Story/Post x Image/Video = 8 files per practice per campaign.
const deliverables = (['V1', 'V2'] as const).flatMap((v) =>
  (['Story', 'Post'] as const).flatMap((size) =>
    (['Image', 'Video'] as const).map((type) => ({ v, size, type, name: `Seasonal_Summer-2026_${type}_${v}_${size}_${client}` })),
  ),
);
const folders = [
  { dir: 'web', file: 'hero_2400w.webp' },
  { dir: 'ads', file: 'story_1080x1920.jpg' },
  { dir: 'social', file: 'post_1080x1350.jpg' },
  { dir: 'print', file: 'brochure_300dpi.tif' },
];
const lastAd = deliverables.at(-1)!.name;
const lastPhoto = `library/${folders.at(-1)!.dir}/${folders.at(-1)!.file}`;
---

<section id="systems" class="relative py-[clamp(80px,12vh,128px)]" data-wired aria-labelledby="systems-title">
  <Wire portTop="clamp(80px, 12vh, 128px)" />
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
      <div>
        <h2 id="systems-title" class="max-w-[20ch] text-h2">Two pipelines I built, and what they produce</h2>
        <p class="mt-4 max-w-[58ch] text-body text-muted">
          I built the ad generator for campaigns across around 40 practices, and the photo intake pipeline to turn client shoots into production-ready libraries.
        </p>
      </div>
      <button type="button" class="pl-replay btn btn-ghost btn-sm" data-replay hidden>
        <Icon name="ph:arrow-counter-clockwise" size={16} aria-hidden="true" /> Replay pipelines
      </button>
    </div>

    <div class="window mt-10" data-pipelines>
      {lanes.map((lane) => (
        <section class="lane" aria-labelledby={`lane-${lane.id}`} data-lane={lane.id}>
          <div class="lane-head">
            <h3 id={`lane-${lane.id}`} class="text-h3">{lane.title}</h3>
            <p class="text-small text-muted">{lane.blurb}</p>
            {lane.example && <span class="ph-chip" data-todo="verify">Example steps</span>}
          </div>

          <div class="lane-graph grid-canvas" data-graph>
            <svg data-edges class="pointer-events-none absolute inset-0 z-[1] size-full" aria-hidden="true">
              {lane.steps.slice(0, -1).map((_, i) => (
                <path class="edge" data-state="done" data-stage-edge data-from={`${lane.id}-s${i}:out`} data-to={`${lane.id}-s${i + 1}:in`} data-from-compact={`${lane.id}-s${i}:down`} data-to-compact={`${lane.id}-s${i + 1}:up`} />
              ))}
              <path class="edge" data-state="done" data-link data-from={`${lane.id}-s${lane.steps.length - 1}:out`} data-to={`${lane.id}-out:in`} data-from-compact={`${lane.id}-s${lane.steps.length - 1}:down`} data-to-compact={`${lane.id}-out:up`} />
              <circle class="packet" r="3" opacity="0" />
              <circle class="packet" r="3" opacity="0" />
            </svg>

            <ol class="lane-steps" aria-label={`${lane.title} steps`}>
              {lane.steps.map((s, i) => (
                <li class="node lane-step" data-node={`${lane.id}-s${i}`} data-stage data-state="done">
                  {i > 0 && <span class="port step-in" />}
                  <Icon name={s.icon} size={18} class="shrink-0 text-primary" aria-hidden="true" />
                  <span class="min-w-0">
                    <span class="block truncate text-meta text-ink">{s.title}</span>
                    <span class="block text-[0.75rem] leading-snug text-muted">{s.meta}</span>
                  </span>
                  <Icon name="ph:check-bold" size={12} class="node-check ml-auto shrink-0" aria-hidden="true" />
                  <span class="port step-out" />
                </li>
              ))}
            </ol>

            <div class="node lane-out" data-node={`${lane.id}-out`} data-output data-state="done">
              <span class="port out-in" />
              {lane.id === 'ads' ? (
                <>
                  <p class="node-head">8 files for one practice <Icon name="ph:check-bold" size={12} class="node-check ml-auto" aria-hidden="true" /></p>
                  <div class="px-3.5 pt-3 pb-3.5">
                    <ul role="list" class="out-frames" aria-label="The 8 deliverables">
                      {deliverables.map((d) => (
                        <li class="out-item" data-item data-state="done" data-name={d.name}>
                          <AdFrame size={d.size} color={persona.color} />
                          <Icon name={d.type === 'Video' ? 'ph:film-strip' : 'ph:image'} size={11} class="mx-auto mt-1 text-muted" aria-hidden="true" />
                          <span class="sr-only">{d.v} {d.size} {d.type}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="mt-3 flex items-center gap-2">
                      <span class="min-w-0 flex-1 font-mono text-[0.6875rem] wrap-anywhere text-ink" data-ticker data-idle="Waiting for render" data-final={lastAd} aria-hidden="true">{lastAd}</span>
                      <span class="sr-only">Example file name: {lastAd}</span>
                      <span class="ph-chip">Illustrative</span>
                    </p>
                    <p class="mt-2 text-[0.8125rem] text-muted">About 320 files per campaign across ~40 practices.</p>
                    <span class="ph-chip mt-1.5" data-todo="verify">Estimate, verify</span>
                  </div>
                </>
              ) : (
                <>
                  <p class="node-head">Production library <Icon name="ph:check-bold" size={12} class="node-check ml-auto" aria-hidden="true" /></p>
                  <div class="px-3.5 pt-3 pb-3.5">
                    <ul role="list" class="grid gap-2" aria-label="Library folders">
                      {folders.map((f) => (
                        <li class="out-item out-folder" data-item data-state="done" data-name={`library/${f.dir}/${f.file}`}>
                          <Icon name="ph:folder-simple" size={16} class="shrink-0 text-primary" aria-hidden="true" />
                          <span class="w-14 font-mono text-[0.75rem] text-ink">/{f.dir}</span>
                          <span class="out-thumbs" aria-hidden="true">{Array.from({ length: 4 }, () => <span />)}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="mt-3 flex items-center gap-2">
                      <span class="min-w-0 flex-1 font-mono text-[0.6875rem] wrap-anywhere text-ink" data-ticker data-idle="Waiting for the shoot" data-final={lastPhoto} aria-hidden="true">{lastPhoto}</span>
                      <span class="sr-only">Example file path: {lastPhoto}</span>
                      <span class="ph-chip">Illustrative</span>
                    </p>
                  </div>
                </>
              )}
            </div>
          </div>
        </section>
      ))}

      <dl class="pl-results">
        <div><dt class="meta text-muted">Per practice, per campaign</dt><dd>8 deliverables: V1 and V2, Story and Post, static and animated</dd></div>
        <div><dt class="meta text-muted">Ships alongside</dt><dd>A matching site template with nav, hero, and footer</dd></div>
        <div><dt class="meta text-muted">Production time per campaign</dt><dd><span class="ph-chip" data-todo="metric">Add before</span> <Icon name="ph:arrow-right" size={12} class="inline text-muted" aria-label="to" /> <span class="ph-chip" data-todo="metric">Add after</span></dd></div>
        <div><dt class="meta text-muted">Hours per photo shoot</dt><dd><span class="ph-chip" data-todo="metric">Add before</span> <Icon name="ph:arrow-right" size={12} class="inline text-muted" aria-label="to" /> <span class="ph-chip" data-todo="metric">Add after</span></dd></div>
      </dl>
      <p class="sr-only" role="status" data-status></p>
    </div>
    <p class="mt-4 text-small text-muted">
      The ad generator steps match the tool I use at OrthoBoost. Practice names, file names, and the photo intake steps are stand-ins, since client work stays private.
    </p>
  </div>
</section>

<style>
  .lane + .lane { border-top: 1px solid var(--color-line); }
  .lane-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 1.25rem 1.5rem 0;
  }
  .lane-head h3 { font-size: 1.125rem; }
  .lane-head .ph-chip { align-self: center; }

  /* The lane is the size container; the graph inside it switches layout (a container can't
     query itself). */
  .lane { container-type: inline-size; }
  .lane-graph {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    gap: 40px;
    align-items: center;
    padding: 1.25rem 1.5rem 1.5rem;
    background-color: transparent;
  }
  .lane-graph > :where(ol, .lane-out) { position: relative; z-index: 2; }

  /* Wide: steps in a row, output on the right. */
  .lane-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .lane-step { display: flex; align-items: center; gap: 0.5rem; min-height: 58px; padding: 0.5rem 0.625rem; }
  .step-in { left: var(--port-off); top: calc(50% - 4px); }
  .step-out { right: var(--port-off); top: calc(50% - 4px); }
  .out-in { left: var(--port-off); top: calc(50% - 4px); }

  .out-frames { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 6px; align-items: end; }
  .out-item { transition: transform var(--d3) var(--ease-out); }
  .out-item :global(:is(.ad-frame, svg)), .out-item .out-thumbs { transition: opacity var(--d3) var(--ease-std); }
  .out-item:not([data-state='done']) :global(:is(.ad-frame, svg)),
  .out-item:not([data-state='done']) .out-thumbs { opacity: 0.3; }
  .out-frames .out-item:not([data-state='done']) { transform: translateY(3px) scale(0.94); }
  .out-folder { display: flex; align-items: center; gap: 0.625rem; }
  .out-thumbs { display: flex; gap: 4px; }
  .out-thumbs span { width: 22px; height: 15px; border-radius: 3px; background: var(--color-graphic-tint); }

  .pl-results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .pl-results > div { padding: 1rem 1.25rem; }
  .pl-results > div + div { border-left: 1px solid var(--color-line); }
  .pl-results dd { margin-top: 0.25rem; font-size: var(--text-small); line-height: 1.5; color: var(--color-ink); }

  /* Medium: results in a 2x2 grid. */
  @media (max-width: 63.99rem) {
    .pl-results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pl-results > div:nth-child(3) { border-left: 0; }
    .pl-results > div:nth-child(n + 3) { border-top: 1px solid var(--color-line); }
  }
  @media (max-width: 39.99rem) {
    .pl-results { grid-template-columns: minmax(0, 1fr); }
    .pl-results > div + div { border-left: 0; border-top: 1px solid var(--color-line); }
  }

  /* Narrow lanes: one vertical ordered flow, output underneath. The row layout needs ~120px of
     text width per step, which a 1040px lane is the first to provide. */
  @container (max-width: 1040px) {
    .lane-graph { --graph-compact: 1; grid-template-columns: minmax(0, 1fr); gap: 36px; padding-inline: 1rem; }
    .lane-steps { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .lane-step { min-height: 48px; }
    .step-in { left: calc(50% - 4px); top: var(--port-off); }
    .step-out { right: auto; top: auto; left: calc(50% - 4px); bottom: var(--port-off); }
    .out-in { left: calc(50% - 4px); top: var(--port-off); }
  }
  @container (max-width: 380px) {
    .out-frames { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>

<script>
  import { layoutEdges, reducedMotion, watchVisibility } from '../scripts/graph';
  import { createPipelineRunner } from '../scripts/pipeline';

  const root = document.querySelector<HTMLElement>('[data-pipelines]');
  const replay = document.querySelector<HTMLButtonElement>('[data-replay]');
  if (root && replay) {
    const lanes = [...root.querySelectorAll<HTMLElement>('[data-lane]')];
    const relayouts = lanes.map((l) => layoutEdges(l.querySelector<HTMLElement>('[data-graph]')!));
    const runners = lanes.map((l) => createPipelineRunner(l));
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const LANE_OFFSET = 400;
    let started = false;
    let runId = 0;

    const playAll = () => {
      const id = ++runId;
      status.textContent = '';
      relayouts.forEach((r) => r());
      // Layout runs in the rAF queued by relayout; the lanes start in the frame after it.
      requestAnimationFrame(async () => {
        if (id !== runId) return;
        const first = runners[0].play();
        await new Promise((r) => setTimeout(r, LANE_OFFSET));
        if (id !== runId) return;
        const done = await Promise.all([first, runners[1].play()]);
        if (id === runId && done.every(Boolean)) {
          status.textContent = 'Both pipelines finished: 8 files for one practice, and a production library from one shoot.';
        }
      });
    };

    // Fully offscreen or tab hidden: settle into the final state instead of animating unseen.
    const settle = () => {
      if (!started) return; // before the first run, the ready state must stay as it is
      runId++;
      runners.forEach((r) => r.finish());
    };

    replay.hidden = false;
    replay.addEventListener('click', () => {
      started = true;
      playAll();
    });
    if (!reducedMotion.matches) runners.forEach((r) => r.reset());
    watchVisibility(root, (visible) => {
      if (!visible || started) return;
      started = true;
      playAll();
    }, 0.3);
    watchVisibility(root, (onScreen) => onScreen || settle(), 0);
    document.addEventListener('visibilitychange', () => document.hidden && settle());
  }
</script>
