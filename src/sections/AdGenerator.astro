  /* Very narrow: the 4-frame rows pair up so frames stay legible. */
  @container (max-width: 339px) {
    .out-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tick {
      min-height: 2.8em;
    }
