  /* ── Wide: four gates in one row, Render + output below ── */
  @container (min-width: 1100px) {
    .ad-gates {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 240px minmax(0, 1.9fr);
      gap: 32px;
    }
    .pm,
    .pmn {
      display: none;
    }
    .pw,
    .pwm {
      display: block;
