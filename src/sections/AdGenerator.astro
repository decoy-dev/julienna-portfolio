</style>

<script>
  import { layoutEdges, reducedMotion, watchVisibility } from '../scripts/graph';
  import { createAdGenerator } from '../scripts/ad-generator';

  const section = document.querySelector<HTMLElement>('#systems');
  const lane = section?.querySelector<HTMLElement>('[data-lane]');
  const replay = section?.querySelector<HTMLButtonElement>('[data-replay]');
  if (section && lane && replay) {
    const status = lane.querySelector<HTMLElement>('[data-status]')!;
    const graph = lane.querySelector<HTMLElement>('[data-graph]')!;
    const runner = createAdGenerator(lane);
    const relayout = layoutEdges(graph);
    let started = false;
    let inView = false;
    let runId = 0;

    // The shipped finished state stays visible until a run actually starts (play resets first);
    // an armed section plays the next time its graphic scrolls in.
    const arm = () => {
      runId++;
      started = false;
    };
    const play = (announce = false) => {
      const id = ++runId;
      started = true;
      relayout();
      // Layout runs in the rAF queued by relayout; the run starts in the frame after it.
      requestAnimationFrame(async () => {
        if (id !== runId) return;
        if (document.hidden || !inView) return arm();
        if ((await runner.play()) && announce && id === runId) {
          status.textContent = 'Ad generator finished: 8 files for one practice.';
        }
      });
    };
    const settle = () => {
      if (!started) return;
      runId++;
      runner.finish();
    };

    replay.hidden = false;
    replay.addEventListener('click', () => {
      status.textContent = '';
      if (inView && !document.hidden) play(true);
      else arm();
    });

    // Autoplay sentinel: the graphic's top band, via a pixel rootMargin. A ratio threshold on the
    // whole graphic is unreachable once the stacked layout grows taller than the viewport.
    new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          inView = e.isIntersecting;
          if (inView && !started && !document.hidden && !reducedMotion.matches) play();
        }
      },
      { rootMargin: '0px 0px -160px 0px' },
    ).observe(graph);
    // Settle once the whole section is offscreen: the next visit starts clean, never mid-state.
    watchVisibility(section, (onScreen) => onScreen || settle(), 0);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) return settle();
      // Back from a hidden tab: a run that came into view meanwhile starts now.
      if (inView && !started && !reducedMotion.matches) play();
    });
  }
</script>
