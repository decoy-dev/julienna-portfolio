  /* Two-column content gate: candidates left, photo/logo/preview right. */
  @container (min-width: 688px) {
    .slots {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 16px;
      grid-template-areas: 'h p' 's v' 'c v' 'l v';
