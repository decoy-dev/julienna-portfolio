---
import { Icon } from 'astro-icon/components';
import template from '../data/split-stack.json';

// Real excerpt from the Split Stack template (OrthoBoost ad generator repo).
const excerpt = {
  slug: template.slug,
  slots: template.slots,
  placement: { Story: template.placement.Story },
  videoGrammar: {
    durationMs: template.videoGrammar.durationMs,
    loop: template.videoGrammar.loop,
    reducedMotion: template.videoGrammar.reducedMotion,
    beats: template.videoGrammar.beats.slice(0, 3),
  },
};
// Tokenize JSON for light syntax tinting (keys vs values) without a highlighter dependency.
const json = JSON.stringify(excerpt, null, 2);
const tokens = json.split(/("(?:[^"\\]|\\.)*"(?=\s*:))/g).map((part, i) => ({ part, key: i % 2 === 1 }));

const gates = ['Persona selected', 'Brand kit applied', 'Template chosen', 'Content complete', 'Render'];
const namingParts = ['{Ad Set}', '{Theme-YYYY}', '{Type}', '{Version}', '{Size}', '{Client}'];
const human = ['Campaign concepts', 'Persona definitions', 'Layout design in Figma', 'Final approval'];
const tools = ['Template drafts (Claude)', 'Variants and sizes', 'File naming and export', 'Asset prep'];
---

<section class="py-[clamp(80px,12vh,128px)]" aria-labelledby="ai-title">
  <div class="shell">
    <h2 id="ai-title" class="max-w-[18ch] text-h2">AI drafts. Rules decide. I direct.</h2>
    <p class="mt-4 max-w-[56ch] text-body text-muted">
      I put AI where the repetition lives. Every creative call stays with me.
    </p>

    <div class="bento mt-10">
      <article class="cell cell-a grid-canvas-ink text-white">
        <div class="flex items-center gap-2 text-on-ink-muted">
          <Icon name="ph:brackets-curly" size={18} aria-hidden="true" />
          <span class="label">split-stack.json</span>
        </div>
        <h3 class="mt-5 text-h3 text-white">No LLM in the render path</h3>
        <p class="mt-2 max-w-[44ch] text-small text-on-ink-muted">
          Claude drafts templates. Rules render the ads, from the approved template, persona, and brand kit.
        </p>
        <pre class="code mt-6" aria-label="Excerpt from the Split Stack template definition"><code>{tokens.map((t) => (t.key ? <span class="k">{t.part}</span> : t.part))}</code></pre>
      </article>

      <article class="cell cell-b bg-surface-2">
        <Icon name="ph:timer" size={22} class="text-primary" aria-hidden="true" />
        <p class="mt-6 text-display leading-none text-ink">40%</p>
        <h3 class="mt-3 text-h3">Less catalog production time</h3>
        <p class="mt-2 max-w-[40ch] text-small text-muted">
          The AI tooling I introduced at Machine Communications cut catalog and brochure production time by 40%.
        </p>
      </article>

      <article class="cell cell-c bg-bg shadow-raised">
        <h3 class="text-h3">Gated, step by step</h3>
        <p class="mt-2 text-small text-muted">Persona, brand kit, template, and content are all selected before anything renders.</p>
        <ol class="mt-5 grid gap-2" aria-label="Render gates">
          {gates.map((g, i) => (
            <li class="flex items-center gap-2.5 text-small font-medium text-ink">
              <span class="grid size-5 place-items-center rounded-full bg-graphic-tint text-primary">
                <Icon name={i === gates.length - 1 ? 'ph:play-fill' : 'ph:check-bold'} size={11} aria-hidden="true" />
              </span>
              {g}
            </li>
          ))}
        </ol>
      </article>

      <article class="cell cell-d bg-graphic-tint">
        <Icon name="ph:file-text" size={22} class="text-primary" aria-hidden="true" />
        <h3 class="mt-5 text-h3">One naming convention</h3>
        <p class="mt-2 text-small text-muted">Every deliverable follows the same pattern, so files sort and hand off predictably.</p>
        <p class="naming mt-5" aria-label="File name pattern: Ad set, theme and year, type, version, size, client">
          {namingParts.map((p, i) => (
            <>
              <span class:list={['tok', { 'tok-live': p === '{Client}' }]}>{p}</span>
              {i < namingParts.length - 1 && <span class="sep">_</span>}
            </>
          ))}
        </p>
      </article>

      <article class="cell cell-e bg-bg shadow-raised">
        <h3 class="text-h3">Human direction on every decision</h3>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="label flex items-center gap-2 text-primary"><Icon name="ph:user" size={14} aria-hidden="true" /> I decide</p>
            <ul role="list" class="mt-3 grid gap-2">
              {human.map((h) => <li class="text-small font-medium text-ink">{h}</li>)}
            </ul>
          </div>
          <div>
            <p class="label flex items-center gap-2 text-muted"><Icon name="ph:gear-six" size={14} aria-hidden="true" /> Tools handle</p>
            <ul role="list" class="mt-3 grid gap-2">
              {tools.map((t) => <li class="text-small text-muted">{t}</li>)}
            </ul>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
  }
  .cell { border-radius: var(--radius-card); padding: clamp(1.25rem, 2.5vw, 2rem); min-width: 0; }
  @media (min-width: 64rem) {
    .bento { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(180px, auto); }
    .cell-a { grid-column: span 7; grid-row: span 2; }
    .cell-b { grid-column: span 5; }
    .cell-c { grid-column: span 5; }
    .cell-d { grid-column: span 5; }
    .cell-e { grid-column: span 7; }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cell-a, .cell-e { grid-column: 1 / -1; }
  }
  .code {
    margin: 0;
    padding: 1rem 1.125rem;
    border-radius: var(--radius-inset);
    background: oklch(1 0 0 / 0.04);
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.08);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-on-ink-muted);
    overflow: auto;
    max-height: 340px;
    scrollbar-color: oklch(1 0 0 / 0.2) transparent;
  }
  .code .k { color: var(--color-graphic); }
  .naming {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink);
  }
  .tok { padding: 0.125rem 0.25rem; border-radius: 4px; background: var(--color-bg); }
  .tok-live { box-shadow: inset 0 -2px 0 var(--color-graphic-deep); }
  .sep { padding-inline: 0.125rem; color: var(--color-muted); }
</style>
