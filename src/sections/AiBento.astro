---
import { Icon } from 'astro-icon/components';
import template from '../data/split-stack.json';

// Real excerpt from the Split Stack template (OrthoBoost ad generator repo), trimmed to what reads
// at a glance: which slots exist and where the Story safe areas sit.
const excerpt = {
  slug: template.slug,
  slots: template.slots,
  placement: { Story: template.placement.Story },
};
// Keep flat arrays and small objects on one line so the excerpt stays around ten lines.
const json = JSON.stringify(excerpt, null, 2).replace(/[[{]\n\s+([^[\]{}]*?)\n\s+[\]}]/g, (m, body: string) =>
  `${m[0]} ${body.replace(/\n\s+/g, ' ')} ${m.at(-1)}`,
);
// Tokenize JSON for light syntax tinting (keys vs values) without a highlighter dependency.
const tokens = json.split(/("(?:[^"\\]|\\.)*"(?=\s*:))/g).map((part, i) => ({ part, key: i % 2 === 1 }));

const gates = ['Persona selected', 'Brand kit applied', 'Template chosen', 'Content complete', 'Render'];
const human = ['Campaign concepts', 'Persona definitions', 'Layout design in Figma', 'Final approval'];
const tools = ['Template drafts (Claude)', 'Every size and version', 'File naming and export'];
---

<section class="py-[clamp(80px,12vh,128px)]" aria-labelledby="ai-title">
  <div class="shell">
    <h2 id="ai-title" class="max-w-[18ch] text-h2">I use AI for the repetitive half</h2>
    <p class="mt-4 max-w-[56ch] text-body text-muted">
      I use Claude to draft templates, then render the ads with fixed rules. That leaves my time for the concepts and for signing off on every piece.
    </p>

    <div class="bento mt-10">
      <article class="cell cell-a grid-canvas-ink text-white">
        <div class="flex items-center gap-2 text-on-ink-muted">
          <Icon name="ph:brackets-curly" size={18} aria-hidden="true" />
          <span class="font-mono text-[0.75rem]">split-stack.json</span>
        </div>
        <h3 class="mt-5 text-h3 text-white">No LLM in the render path</h3>
        <p class="mt-2 max-w-[44ch] text-small text-on-ink-muted">
          Claude helps me draft new templates. The ads themselves come from fixed rules applied to the chosen persona, brand kit, template, and content.
        </p>
        <pre class="code mt-6" aria-label="Excerpt from the Split Stack template definition"><code>{tokens.map((t) => (t.key ? <span class="k">{t.part}</span> : t.part))}</code></pre>
      </article>

      <article class="cell cell-b bg-surface-2">
        <Icon name="ph:timer" size={22} class="text-primary" aria-hidden="true" />
        <p class="mt-6 text-display leading-none text-ink">40%</p>
        <h3 class="mt-3 text-h3">Less catalog production time</h3>
        <p class="mt-2 max-w-[40ch] text-small text-muted">
          I introduced AI tooling at Machine Communications that cut catalog and brochure production time by 40%.
        </p>
      </article>

      <article class="cell cell-c bg-bg shadow-raised">
        <h3 class="text-h3">Nothing renders half set up</h3>
        <p class="mt-2 text-small text-muted">Each step unlocks once the one before it is complete, so a missing logo or headline stops the run before it reaches a file.</p>
        <ol class="mt-5 grid gap-2" aria-label="Render gates">
          {gates.map((g, i) => (
            <li class="flex items-center gap-2.5 text-small font-medium text-ink">
              <span class="grid size-5 place-items-center rounded-full bg-graphic-tint text-primary">
                <Icon name={i === gates.length - 1 ? 'ph:play-fill' : 'ph:check-bold'} size={11} aria-hidden="true" />
              </span>
              {g}
            </li>
          ))}
        </ol>
      </article>

      <article class="cell cell-e bg-surface">
        <h3 class="text-h3">Who does what</h3>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="meta flex items-center gap-2 text-primary"><Icon name="ph:user" size={14} aria-hidden="true" /> I decide</p>
            <ul role="list" class="mt-3 grid gap-2">
              {human.map((h) => <li class="text-small font-medium text-ink">{h}</li>)}
            </ul>
          </div>
          <div>
            <p class="meta flex items-center gap-2 text-muted"><Icon name="ph:gear-six" size={14} aria-hidden="true" /> Tools handle</p>
            <ul role="list" class="mt-3 grid gap-2">
              {tools.map((t) => <li class="text-small text-muted">{t}</li>)}
            </ul>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
  }
  .cell { border-radius: var(--radius-card); padding: clamp(1.25rem, 2.5vw, 2rem); min-width: 0; }
  @media (min-width: 64rem) {
    .bento { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(180px, auto); }
    .cell-a { grid-column: span 7; grid-row: span 2; }
    .cell-b { grid-column: span 5; }
    .cell-c { grid-column: span 5; }
    .cell-e { grid-column: 1 / -1; }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cell-a, .cell-e { grid-column: 1 / -1; }
  }
  .code {
    margin: 0;
    padding: 1rem 1.125rem;
    border-radius: var(--radius-inset);
    background: oklch(1 0 0 / 0.04);
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.08);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-on-ink-muted);
    overflow: auto;
    scrollbar-color: oklch(1 0 0 / 0.2) transparent;
  }
  .code .k { color: var(--color-graphic); }
</style>
