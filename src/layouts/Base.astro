---
import '../styles/global.css';
import displayUrl from '../assets/fonts/funnel-display-var.woff2?url';
import sansUrl from '../assets/fonts/funnel-sans-var.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { href } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Link-preview image under public/; defaults to the site card. Bump OG_VERSION when it changes. */
  image?: string;
  imageAlt?: string;
}
const OG_VERSION = '1';
const {
  title,
  description,
  image = '/og.png',
  imageAlt = 'Julienna Batten, web designer and creative director: a whole design team’s output, from one person.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Crawlers need absolute URLs, and the site lives under the /julienna-portfolio base path.
const ogImage = new URL(`${href(image)}?v=${OG_VERSION}`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Julienna Batten" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-bg text-ink">
    <a href="#main" class="sr-only-focusable fixed top-3 left-3 z-(--z-popover) rounded-full bg-ink px-4 py-2 text-small font-semibold text-white">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
